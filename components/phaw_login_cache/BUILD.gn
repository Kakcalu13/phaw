#
# Login-only cache / storage policy component (req 5). See DESIGN.md.
#
# Skeleton: ":public" is complete. ":impl"/":unit_tests" list Phase-1 sources.

source_set("public") {
  sources = [ "public/storage_policy_service.h" ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//url",
  ]
}

source_set("impl") {
  # Phase 1 sources:
  sources = [
    "auth_exception_store.cc",
    "auth_exception_store.h",
    "login_aware_rule.cc",
    "login_aware_rule.h",
    "phaw_cookie_access_delegate.cc",
    "phaw_cookie_access_delegate.h",
    "storage_access_throttle.cc",
    "storage_access_throttle.h",
    "storage_policy_service_factory.cc",
    "storage_policy_service_factory.h",
    "storage_policy_service_impl.cc",
    "storage_policy_service_impl.h",
  ]
  deps = [
    ":public",
    "//components/content_settings/core/browser",
    "//components/keyed_service/content",
    "//components/phaw_common",
    "//components/user_prefs",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true
  # The whole policy is provable here without a browser (see DESIGN.md).
  sources = [ "login_aware_rule_unittest.cc" ]
  deps = [
    ":impl",
    "//testing/gtest",
  ]
}
