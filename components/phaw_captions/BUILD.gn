#
# Live Caption enablement + Win8.1 SODA compatibility probe (req 1). See DESIGN.md.
#
# Skeleton: ":public" is complete. ":impl"/":unit_tests" list Phase-1 sources.

source_set("public") {
  sources = [ "public/caption_service.h" ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
  ]
}

source_set("impl") {
  sources = [
    "caption_backend.h",  # internal backend interface (service depends on this)
    "caption_service_factory.cc",
    "caption_service_factory.h",
    "caption_service_impl.cc",
    "caption_service_impl.h",
    "language_pack_manager.cc",
    "language_pack_manager.h",
    "soda_caption_backend.cc",
    "soda_caption_backend.h",
    "soda_compat_probe.cc",
    "soda_compat_probe.h",
  ]
  deps = [
    ":public",
    "//components/keyed_service/content",
    "//components/live_caption",
    "//components/phaw_common",
    "//components/soda",
    "//components/user_prefs",
    "//content/public/browser",
    "//media",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "caption_service_impl_unittest.cc",
    "soda_compat_probe_unittest.cc",
  ]
  deps = [
    ":impl",
    "//testing/gtest",
  ]
}
