#
# Ad/tracker + anti-adblock component (reqs 2, 3). See DESIGN.md.
#
# Skeleton: ":public" (the interface) is complete. ":impl" and ":unit_tests"
# list their Phase-1 sources; those .cc/.h files are written when the component
# is implemented in the Supermium tree.

source_set("public") {
  sources = [ "public/adblock_service.h" ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//url",
  ]
}

source_set("impl") {
  # Phase 1 sources (concrete impl + collaborators; all private to this dir):
  sources = [
    "adblock_engine.h",  # internal engine interface (throttle depends on this)
    "adblock_service_factory.cc",
    "adblock_service_factory.h",
    "adblock_service_impl.cc",
    "adblock_service_impl.h",
    "adblock_throttle.cc",
    "adblock_throttle.h",
    "cosmetic_injector.cc",
    "cosmetic_injector.h",
    "filter_list_store.cc",
    "filter_list_store.h",
    "rust_adblock_engine.cc",
    "rust_adblock_engine.h",
  ]
  deps = [
    ":public",
    "//components/keyed_service/content",
    "//components/phaw_common",
    "//components/user_prefs",
    "//content/public/browser",
    "//content/public/renderer",
    "//services/network/public/cpp",
    "//third_party/adblock_rust_ffi",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "adblock_throttle_unittest.cc",
    "rust_adblock_engine_unittest.cc",
  ]
  deps = [
    ":impl",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
