#
# phaw build flags. Declared here with defaults; overridden in
# build/config/args.gn. A feature is switched on/off at this boundary — downstream
# code must not branch on these (architecture.md §4); it's compiled in or out.

declare_args() {
  phaw_enable_adblock = true        # reqs 2,3 -> //components/phaw_adblock
  phaw_enable_login_cache = true    # req 5    -> //components/phaw_login_cache
  phaw_enable_collapse_tabs = true  # req 4    -> //chrome/browser/ui/phaw_tabs
  phaw_enable_live_caption = true   # req 1    -> //components/phaw_captions
}
