# phaw GN build args — layered on Supermium's base configuration.
# Copy into src/out/phaw-x86/ (or phaw-x64/) before `autoninja`.
#
# Supermium's repo owns the toolchain/target pins that make Win8.1 work; the
# args below are phaw's additions on top. Verify against Supermium's build docs.

# --- Target ------------------------------------------------------------------
target_cpu = "x86"          # "x86" for 32-bit Win8.1 (first-class), "x64" for 64-bit
target_os  = "win"

# --- Release / branding ------------------------------------------------------
is_debug            = false
is_official_build   = true  # optimized, branded release build
is_component_build  = false # single-binary release (not the dev component build)

# --- Media / captions --------------------------------------------------------
# Live Caption (SODA) and general media playback need the proprietary codecs +
# ffmpeg "Chrome" branding. Without these, req 1 (captions) and most video fail.
proprietary_codecs  = true
ffmpeg_branding     = "Chrome"
enable_platform_hevc = true

# --- Trim things we don't ship ----------------------------------------------
enable_nacl         = false # dead weight; long gone from modern web
enable_widevine     = true  # keep DRM so streaming sites work (many are ad-heavy)

# --- Build speed (dev). Flip for shipping if you want full opt/PGO -----------
symbol_level        = 1     # 0 for fastest local builds; 1 keeps usable stacks
blink_symbol_level  = 0
chrome_pgo_phase    = 0     # 0 = no PGO (simpler/faster); enable for perf release

# --- phaw feature toggles (consumed by patches/, see architecture rule S1) ---
# These are declared in our patch that adds a phaw_features.gni; they switch the
# component factories on. Behavior lives in components/, not here.
phaw_enable_adblock       = true   # reqs 2, 3  -> components/phaw_adblock
phaw_enable_login_cache   = true   # req 5      -> components/phaw_login_cache
phaw_enable_collapse_tabs = true   # req 4      -> components/phaw_tabs
phaw_enable_live_caption  = true   # req 1      -> components/phaw_captions
